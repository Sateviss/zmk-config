#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
// Per-key RGB lighting behavior (&prgb) from this repo's module (dts/, include/)
#include <behaviors/prgb.dtsi>

// The encoders themselves (pins, enable per half) come from the upstream shield.
// Steps must be 4x triggers-per-rotation for exactly one trigger per detent:
// the shield's steps = 80 with 24 triggers fired an extra step every 5th click.
&left_encoder {
    steps = <96>;
};

&right_encoder {
    steps = <96>;
};

// The Aurora Lily58 chains 34 LEDs per half: 5 underglow, then the 29 per-key LEDs.
// The shield only declares 5, which is why the per-key "backlight" never lit up.
// The per-key RGB module (&prgb) drives them as two zones: underglow (0-4), keys (5-33).
&led_strip {
    chain-length = <34>;
};

// Run the OLED bus at 400 kHz (fast mode, supported by the SSD1306) instead of the
// 100 kHz default, so each redraw holds the CPU/bus for a quarter of the time.
&pro_micro_i2c {
    clock-frequency = <400000>;
};

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;

        left_sensor {
            triggers-per-rotation = <24>;
        };

        right_sensor {
            triggers-per-rotation = <24>;
        };
    };
};


/ {    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   '   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |  VOL      L/R ARR |  H   |  J    |  K    |  L   |   ;   |   [   |
// |  CTRL |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   |   ]   |
//                     | MO1  | WIN  | ALT  |  SPACE |  | ENTER | MO2  | BSPC  |  ~    |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3 &kp N4   &kp N5                                 &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp APOS
&kp TAB   &kp Q  &kp W  &kp E  &kp R    &kp T                                  &kp Y  &kp U    &kp I     &kp O   &kp P    &kp BSLH
&kp LSHFT &kp A  &kp S  &kp D  &kp F    &kp G                                  &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp LBKT
&kp LCTRL &kp Z  &kp X  &kp C  &kp V    &kp B     &kp C_MUTE        &kp C_PP   &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RBKT
                        &mo 1  &kp LGUI &kp LALT  &kp SPACE         &kp RET    &mo 2  &kp BSPC &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp LEFT RIGHT>;
        };

        control_layer {
            display-name = "Control";
// ------------------------------------------------------------------------------------------------------------
// RGB: UG = underglow zone (also the reactive accent colour), KEY = per-key zone.
// BGLVL = reactive/ripple background (dim accent tint): 0 -> 5 -> 10 -> 15 -> 25% -> 0.
// RGBMAP = layer key map on/off (keys show their binding type on this layer and Extra,
// BT0-3 their profile state, OUTTG the endpoint; underglow tinted blue here, on Extra
// it stays as on the base layer). PULSE = underglow flashes on key presses on/off.
// Key map colours on this layer: brightness/BGLVL yellow, saturation purple, hue keys
// cycle the rainbow, effect green, speed cyan, toggles pink, BT/out blue (or status),
// system red, layer keys orange, plain keys white. The unbound keys flash the new colour
// when a hue, saturation, brightness or background level changes.
// | BTCLR |OUTTG| BT0 |  BT1 |  BT2 |  BT3 |                   |STUDIO|       |       |      |       |       |
// | RGBTGL|UGHU+| BRT+|KEYHU+| EFF+ | SPD+ |                   |      |       |       |      |       |       |
// | SHIFT |UGHU-| BRT-|KEYHU-| EFF- | SPD- |                   |RGBMAP| PULSE |       |      |       |       |
// | LCTRL |UGSA+|UGSA-|KEYSA+|KEYSA-|BGLVL | KBPWR  |  |       |      |       |       |      |       |       |
//                     |  MO1 | WIN  | ALT  | SPACE  |  | ENTER | MO2  |       |       |
            bindings = <
&bt BT_CLR     &out OUT_TOG         &bt BT_SEL 0         &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3                         &studio_unlock &none    &none   &none &none &none
&prgb PRGB_TOG &prgb PRGB_UG_HUE_UP &prgb PRGB_BRI_UP    &prgb PRGB_KEY_HUE_UP &prgb PRGB_EFF_NEXT   &prgb PRGB_SPD_UP                    &none     &none    &none   &none &none &none
&kp LSHFT      &prgb PRGB_UG_HUE_DN &prgb PRGB_BRI_DN    &prgb PRGB_KEY_HUE_DN &prgb PRGB_EFF_PREV   &prgb PRGB_SPD_DN                    &prgb PRGB_MAP_TOG &prgb PRGB_PULSE_TOG &none &none &none &none
&kp LCTRL      &prgb PRGB_UG_SAT_UP &prgb PRGB_UG_SAT_DN &prgb PRGB_KEY_SAT_UP &prgb PRGB_KEY_SAT_DN &prgb PRGB_BG_NEXT &ext_power EP_TOG &none &none     &none    &none   &none &none &none
                                                         &mo 1                 &kp LGUI              &kp LALT           &kp SPACE &kp RET &mo 2     &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        additional_layer {
            display-name = "Extra";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  F1 | F2  | F3   | F4   |  F5  |                   | F6   |  F7   |  F8   |  -   |   +   |       |
// |  CAPS |     | UP  |      |      |      |                   | F9   |  F10  |  F11  | PGUP |  F12  |       |
// | SHIFT |LEFT |DOWN |RIGHT |      |      | UP/DOWN    CTRLAR |      |INSERT | HOME  | PGDN |  END  |       |
// | LCTRL |     |     |      |      |      |        |  | MUTE  |      |       |       |      |       |       |
//                     |  MO1 | WIN  | ALT  | SPACE  |  | ENTER | MO2  |  DEL  | PAUSE |
            bindings = <
&kp ESC   &kp F1   &kp F2   &kp F3    &kp F4   &kp F5                              &kp F6     &kp F7   &kp F8          &kp MINUS  &kp EQUAL &none
&kp CAPS  &none    &kp UP   &none     &none    &none                               &kp F9     &kp F10  &kp F11         &kp PG_UP  &kp F12   &none
&kp LSHFT &kp LEFT &kp DOWN &kp RIGHT &none    &none                               &kp PSCRN  &kp INS  &kp HOME        &kp PG_DN  &kp END   &none
&kp LCTRL &none    &none    &none     &none    &none     &kp C_MUTE &none          &none      &none    &none           &none      &none     &none
                            &mo 1     &kp LGUI &kp LALT  &kp SPACE  &kp RET        &mo 2      &kp DEL  &kp PAUSE_BREAK
            >;
        
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp RC(LEFT) RC(RIGHT)>;
        };
    };
};
