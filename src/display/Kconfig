# Custom OLED status screen for the splitkb Aurora Lily58 (this repo's ZMK module).
# SPDX-License-Identifier: MIT

config ZMK_OLED_STATUS
    bool "Portrait status screen: battery voltage, lighting effect, connection, layer"
    default y
    depends on ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL
    select LV_FONT_MONTSERRAT_8
    select LV_FONT_MONTSERRAT_10
    select LV_FONT_MONTSERRAT_12
    select ZMK_LOW_PRIORITY_WORK_QUEUE
    # The OLED shows the effect names from the &prgb behavior's ZMK Studio list.
    select ZMK_BEHAVIOR_METADATA if ZMK_PRGB
    imply LV_USE_THEME_MONO
    help
      Implements zmk_display_status_screen() for the 128x32 SSD1306 panels, shown
      rotated to portrait (32x128): connection (central: output / BLE profile;
      peripheral: link to the central), battery icon and voltage, active layer
      (central), per-key RGB effect and brightness. Needs
      CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=y.

if ZMK_OLED_STATUS

choice ZMK_OLED_STATUS_ROTATION
    prompt "Direction the screen content is turned"
    default ZMK_OLED_STATUS_ROTATE_CW
    help
      The panel is mounted landscape; the stock screen reads upright on it. The content
      is turned by 90 degrees in software (the SSD1306 itself can only mirror).

config ZMK_OLED_STATUS_ROTATE_CW
    bool "90 degrees clockwise (top of the content towards the panel's right edge)"

config ZMK_OLED_STATUS_ROTATE_CCW
    bool "90 degrees counter-clockwise (top of the content towards the left edge)"

endchoice

config ZMK_OLED_STATUS_BATTERY_INTERVAL
    int "Seconds between battery voltage readings while active"
    range 5 3600
    default 60
    help
      Also read whenever ZMK's own battery level changes and 2 s after USB power is
      connected or removed. Readings pause while the keyboard is idle (screen off).

endif # ZMK_OLED_STATUS

# LVGL heap: the stock screen gets 4 KB (ZMK sets that only for the built-in screen).
config LV_Z_MEM_POOL_SIZE
    default 4096 if ZMK_OLED_STATUS
